# Copy to .env and fill in the first three.

# From https://my.telegram.org/apps
API_ID=
API_HASH=
# From @BotFather
BOT_TOKEN=

# Numeric Telegram ids of the admins, comma-separated. Admins get the admin
# 🛠 Admin panel button, the backups, and their own limits below.
ADMIN_IDS=

# Optional. A private channel where finished files are kept, so the same file
# sent again is answered instantly instead of processed again. Add the bot to
# the channel as an admin that can post, put its id here (it starts with -100),
# restart, then turn the cache on in the 🛠 Admin panel.
CACHE_CHANNEL_ID=

# Optional. A channel users must join before they can use the bot. Either a
# public channel's @username, or a private channel's id (starting -100) together
# with its invite link. Add the bot to the channel as an admin so it can see who
# is a member, restart, then turn it on in the 🛠 Admin panel.
JOIN_CHANNEL=
JOIN_CHANNEL_LINK=

# How often the database is backed up and sent to every admin, as a zip file.
# 0 turns backups off. 💾 Backup now in the admin panel sends one straight away.
BACKUP_INTERVAL_HOURS=12

# Limits per person, counted on the files they get back, by the size of the
# file they sent. Each is a number of files or of gigabytes, per day or per
# calendar month; 0 means no limit.
USER_DAILY_FILES=20
USER_MONTHLY_FILES=300
USER_DAILY_GB=10
USER_MONTHLY_GB=100
ADMIN_DAILY_FILES=100
ADMIN_MONTHLY_FILES=2000
ADMIN_DAILY_GB=50
ADMIN_MONTHLY_GB=500
# Days and months start at midnight in this time zone, for example Asia/Tehran.
TIMEZONE=UTC

# Largest file accepted, in MB. 2000 is Telegram's own limit for bots.
MAX_FILE_MB=2000
# Files processed at the same time. Others wait in a queue.
WORKERS=2
# Most files waiting in the queue before new ones are turned away.
MAX_QUEUE=50
# Most files one person may have queued or in progress.
JOBS_PER_USER=3
# How long a file's menu stays open without an answer.
MENU_TIMEOUT_MINUTES=15
# How often progress messages are updated. Lower risks Telegram rate limits.
PROGRESS_INTERVAL_SECONDS=5

LOG_LEVEL=INFO

# Only if Docker Hub can't be reached from your server ("TLS handshake
# timeout" while building): the same official Python image from a mirror.
# Either of these works:
#   mirror.gcr.io/library/python:3.14-slim
#   public.ecr.aws/docker/library/python:3.14-slim
PYTHON_IMAGE=

# Set by compose.yaml, not here: where jobs keep their files (the volume shared
# with the media worker), and the worker's socket. Leave MEDIA_SOCKET unset to
# run ffmpeg inside the bot instead, for trying it out without Docker.
# SCRATCH_DIR=
# MEDIA_SOCKET=
